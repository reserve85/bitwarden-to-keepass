# Copy this file to `.env` and adjust the values to your needs:
#   cp .env.example .env
#
# SECURITY: the automated export NEVER prompts for email/password. In this
# non-TTY environment `bw login` / `bw unlock` would echo the typed secrets in
# clear text (and redirected output would write them to disk). Instead, provide
# a personal API key below (vault.bitwarden.com -> Settings -> Security ->
# Keys) together with BW_PASSWORD (your Bitwarden MASTER password), or a
# pre-generated BW_SESSION. The script refuses to start without them.
#BW_CLIENTID=user.xxxx-xxxx-xxxx-xxxx
#BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#BW_PASSWORD=    # Bitwarden MASTER password. Current Bitwarden/Vaultwarden
                 # servers only create a *locked* session from the API key;
                 # the container unlocks it with `bw unlock --passwordenv`
                 # (reads the env var, no prompt, no echo). This is NOT the
                 # KeePass DATABASE_PASSWORD!
#BW_SESSION=     # Alternative: session key from a manual `bw unlock --raw`.

# Password for the KeePass database - REQUIRED (otherwise run.py prompts via
# getpass, which echoes the input in clear text when there is no TTY).
#DATABASE_PASSWORD=
#DATABASE_KEYFILE=
DATABASE_PATH=/exports/bitwarden-export.kdbx
BW_PATH=/usr/local/bin/bw

# Use "https://bitwarden.eu" if your account is in EU region
# You can also set custom URL in case you are self-hosting
BITWARDEN_URL=https://bitwarden.com

# =============================================================================
#  Host-side configuration (used by "create_backup.ps1" only).
#  These keys are read on the Windows host; the Docker container ignores them.
# =============================================================================

# Local git checkout of this repository that is run against Docker.
REPO_DIR=C:\path\to\bitwarden-to-keepass-checkout

# Docker Compose service name from docker-compose.yaml
COMPOSE_SERVICE=bitwarden-to-keepass

# Semicolon-separated list of folders that receive a copy of the export.
# Folders may now contain spaces (unlike with the old batch script).
BACKUP_DIRS=C:\Users\<you>\OneDrive\KeePass;C:\Users\<you>\Dropbox\Backup\KeePass

# "true" pulls the latest version and rebuilds the Docker image before the
# export. Set to "false" to run the existing checkout and image (faster,
# deterministic) - e.g. for nightly scheduled backups.
PULL_LATEST=true

# Seconds to wait for the Docker daemon to become reachable before giving up.
# Docker Desktop's UI opens before the engine (WSL2) is ready, which used to
# fail the script spuriously right after startup. Default: 30.
DOCKER_WAIT_SECONDS=30

# Optional: write a timestamped run log to this file (empty = no log file)
#LOG_FILE=C:\path\to\bitwarden-to-keepass-backup.log